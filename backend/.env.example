NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=colegio_app
DB_PASSWORD=
DB_NAME=colegio_saas
DB_POOL_SIZE=10

# Mínimo 32 caracteres. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# Carpeta para archivos subidos (proveedor local). No se versiona.
UPLOADS_DIR=uploads

# Cada cuántas horas se recuerda una corrección pendiente
REMINDER_INTERVAL_HOURS=24

# Recordatorios y activación de unidades (node-cron). false en pruebas automatizadas.
JOBS_ENABLED=true
